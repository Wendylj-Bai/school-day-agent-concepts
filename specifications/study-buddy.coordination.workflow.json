{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {"title": "Study Buddy: Learner Practice with Family and Educator Support", "quality_profile": "showcase"},
  "lanes": [
    {"id": "experience", "label": "Student Practice and Fixed Checks"},
    {"id": "agents", "label": "Two-Agent Learning Loop"},
    {"id": "support", "label": "Vetted Tools and Human Participation", "variant": "exception"}
  ],
  "phases": [
    {"id": "observe", "label": "Observe", "fromCol": 0, "toCol": 1},
    {"id": "adapt", "label": "Interpret + teach", "fromCol": 2, "toCol": 3, "variant": "emphasis"},
    {"id": "verify", "label": "Check + coordinate", "fromCol": 4, "toCol": 5, "variant": "dashed"}
  ],
  "groups": [
    {"id": "agent_roles", "label": "Learning review and teaching responsibilities", "lane": "agents", "fromCol": 1, "toCol": 2, "variant": "emphasis"},
    {"id": "human_loop", "label": "Human participation", "lane": "support", "fromCol": 4, "toCol": 5, "variant": "security"}
  ],
  "mainPath": ["attempt", "answer_check", "state_agent", "teaching_agent", "fresh_question", "new_check", "transfer_check"],
  "semanticChecks": {
    "allowedRoots": ["attempt"],
    "allowedTerminals": ["support_team"],
    "requiredPaths": [
      {"from": "attempt", "to": "transfer_check"},
      {"from": "transfer_check", "to": "support_team"},
      {"from": "strategy_retry", "to": "teaching_agent"},
      {"from": "strategy_retry", "to": "support_team"}
    ]
  },
  "nodes": [
    {"id": "attempt", "lane": "experience", "col": 0, "type": "external", "label": "Practice Attempt", "width": 140},
    {"id": "answer_check", "lane": "experience", "col": 1, "type": "security", "label": "Answer Check", "sublabel": "first attempt", "tag": "fixed rules", "width": 140},
    {"id": "fresh_question", "lane": "experience", "col": 3, "type": "frontend", "label": "Fresh Check Question", "sublabel": "different example", "width": 150},
    {"id": "new_check", "lane": "experience", "col": 4, "type": "security", "label": "New Answer Check", "sublabel": "same fixed rules", "tag": "fixed rules", "width": 144},
    {"id": "transfer_check", "lane": "experience", "col": 5, "type": "security", "label": "Mock Quiz", "sublabel": "no hints · independent", "tag": "fixed rules", "width": 144},
    {"id": "state_agent", "lane": "agents", "col": 1, "type": "backend", "label": "Learning Review Agent", "sublabel": "possible learning difficulty", "width": 160},
    {"id": "teaching_agent", "lane": "agents", "col": 2, "type": "backend", "label": "Teaching Agent", "sublabel": "selects strategy", "width": 140},
    {"id": "strategy_retry", "lane": "agents", "col": 4, "type": "messagebus", "label": "Try Another Method", "sublabel": "one approved retry", "width": 150},
    {"id": "activity_tool", "lane": "support", "col": 2, "type": "database", "label": "Vetted Activities", "sublabel": "approved hints", "width": 140},
    {"id": "support_summary", "lane": "support", "col": 4, "type": "messagebus", "label": "Support Summary", "sublabel": "progress and needs", "width": 140},
    {"id": "support_team", "lane": "support", "col": 5, "type": "external", "label": "Support Team", "sublabel": "parent, teacher, adviser", "tag": "human participation", "width": 140}
  ],
  "edges": [
    {"id": "attempt_check", "from": "attempt", "to": "answer_check", "label": "submit", "variant": "default"},
    {"id": "check_state", "from": "answer_check", "to": "state_agent", "label": "attempt evidence", "variant": "emphasis"},
    {"id": "state_teach", "from": "state_agent", "to": "teaching_agent", "label": "possible difficulty", "variant": "emphasis"},
    {"id": "teach_activity", "from": "teaching_agent", "to": "activity_tool", "label": "select strategy", "variant": "default"},
    {"id": "activity_teach", "from": "activity_tool", "to": "teaching_agent", "label": "approved hint", "variant": "emphasis", "role": "return"},
    {"id": "teach_question", "from": "teaching_agent", "to": "fresh_question", "label": "hint + practice", "variant": "emphasis"},
    {"id": "question_check", "from": "fresh_question", "to": "new_check", "label": "submit", "variant": "default"},
    {"id": "check_quiz", "from": "new_check", "to": "transfer_check", "label": "correct", "variant": "emphasis"},
    {"id": "check_retry", "from": "new_check", "to": "strategy_retry", "label": "still incorrect", "variant": "dashed", "role": "branch"},
    {"id": "retry_teach", "from": "strategy_retry", "to": "teaching_agent", "label": "new approved method", "variant": "dashed", "role": "return"},
    {"id": "retry_summary", "from": "strategy_retry", "to": "support_summary", "label": "limit reached", "variant": "security", "role": "branch"},
    {"id": "quiz_summary", "from": "transfer_check", "to": "support_summary", "label": "session result", "variant": "security", "role": "branch"},
    {"id": "summary_team", "from": "support_summary", "to": "support_team", "label": "authorized view", "variant": "security"}
  ]
}
